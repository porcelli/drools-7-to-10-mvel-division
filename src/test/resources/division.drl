package example;

global java.util.Map results;

rule "literal division in a consequence"
    dialect "mvel"
when
then
    results.put("literal", 7 / 2);
end

rule "typed operands in a consequence"
    dialect "mvel"
when
    $input : DivisionInput($n : numerator, $d : divisor, $boxed : boxedDivisor)
then
    results.put("primitive", $n / $d);
    results.put("boxed", $n / $boxed);
end

rule "primitive division crosses a threshold"
    dialect "mvel"
when
    DivisionInput($n : numerator, $d : divisor)
    eval($n / $d > 3)
then
    results.put("aboveThreshold", true);
end
