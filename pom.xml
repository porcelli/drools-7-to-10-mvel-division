<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>example</groupId>
  <artifactId>drools-7-to-10-mvel-division</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <modules>
    <module>drools-7</module>
    <module>drools-10</module>
  </modules>
  <profiles>
    <profile>
      <id>aletyx</id>
      <modules>
        <module>aletyx-horizon</module>
      </modules>
    </profile>
  </profiles>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <model.project>org.drools.model.codegen.ExecutableModelProject</model.project>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <testSourceDirectory>${project.basedir}/../src/test/java</testSourceDirectory>
    <testResources>
      <testResource>
        <directory>${project.basedir}/../src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <systemPropertyVariables>
            <comparison.build>${project.artifactId} ${comparison.version}</comparison.build>
            <model.project>${model.project}</model.project>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
